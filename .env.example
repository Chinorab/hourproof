# Option A: Claude API key from console.anthropic.com (used when set)
ANTHROPIC_API_KEY=

# Option B: Amazon Bedrock (used when ANTHROPIC_API_KEY is empty)
AWS_REGION=us-east-1
# Either a Bedrock API key...
AWS_BEARER_TOKEN_BEDROCK=
# ...or IAM credentials limited to Bedrock model invocation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: override the Bedrock model ID (default anthropic.claude-opus-5-5)
BEDROCK_MODEL_ID=
